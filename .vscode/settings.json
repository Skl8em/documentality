{
  // Point the markdownlint extension at the same config + custom rule the CLI uses,
  // so the editor and `markdownlint-cli2` apply one ruleset.
  "markdownlint.configFile": ".markdownlint.jsonc",
  "markdownlint.customRules": ["./docsys/src/docsys/markdownlint/sentence-per-line.js"],

  // This folder's interpreter: the .venv `uv sync` builds inside the devShell, on the
  // flake's Python. Without it, the editor falls back to whatever global Python it
  // finds. The engine, docsys/, has its own (docsys/.vscode/settings.json).
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // basedpyright, not Pylance, checks types, and Ruff lints and formats: the copies
  // `uv sync` locks into the .venv above, with pyproject.toml's configuration, which
  // the gate runs too. Ruff is named by path, so a missing .venv is an error rather
  // than a silent fallback to the extension's own copy.
  "python.analysis.typeCheckingMode": "off",
  "basedpyright.importStrategy": "fromEnvironment",
  "ruff.path": ["${workspaceFolder}/.venv/bin/ruff"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  }
}
