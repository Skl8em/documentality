{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docs: run the gate",
      "detail": "docsys check, every check docsys.yaml configures; failures land in the Problems pane",
      "type": "shell",
      "command": "if [ -z \"${DOCSYS_DEVSHELL:-}\" ]; then exec nix develop --command uv run --locked docsys check; fi; exec uv run --locked docsys check",
      "group": "test",
      "problemMatcher": [
        {
          "owner": "docsys-gate",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "source": "docsys",
          "severity": "error",
          "pattern": {
            "regexp": "^([^\\s:]+):(\\d+): ([a-z0-9-]+/[a-z0-9-]+): (.+)$",
            "file": 1,
            "line": 2,
            "code": 3,
            "message": 4
          }
        },
        {
          "owner": "docsys-gate",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "source": "docsys",
          "severity": "warning",
          "pattern": {
            "regexp": "^  ([^\\s:]+):(\\d+): ([a-z0-9-]+/[a-z0-9-]+): (.+)$",
            "file": 1,
            "line": 2,
            "code": 3,
            "message": 4
          }
        },
        {
          "owner": "docsys-gate",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "source": "markdownlint",
          "severity": "error",
          "pattern": {
            "regexp": "^([^\\s:]+):(\\d+)(?::(\\d+))? ([^\\s/]+(?:/[^\\s/]+)+) (.+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "code": 4,
            "message": 5
          }
        },
        {
          "owner": "docsys-gate",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "source": "docsys",
          "severity": "error",
          "pattern": {
            "kind": "file",
            "regexp": "^docsys: (docsys\\.yaml): (.+)$",
            "file": 1,
            "message": 2
          }
        }
      ]
    }
  ]
}
