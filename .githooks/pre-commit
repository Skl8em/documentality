#!/bin/sh
# Documentation gate — `docsys check`, every check docsys.yaml configures.
# Opt in once with:  git config core.hooksPath .githooks
# Inside the devShell, uv, the interpreter and markdownlint-cli2 are the versions
# flake.lock pins; outside it, the hook enters it first.
if [ -z "${DOCSYS_DEVSHELL:-}" ]; then
  exec nix develop --command uv run --locked docsys check
fi
exec uv run --locked docsys check
